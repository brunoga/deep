{
  "name": "@brunoga/deep-patch",
  "version": "0.1.0",
  "description": "Produce and apply deep patches from JavaScript \u2014 the wire format of github.com/brunoga/deep",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "diff",
    "patch",
    "json-pointer",
    "sync",
    "crdt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.9.0"
  }
}
