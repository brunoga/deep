# Editor swap files
*.swp
*.swo

# macOS
.DS_Store

# Test binaries and coverage
*.test
coverage.out

# Compiled generator binary
/deep-gen

# Compiled example binaries. `go build ./cmd/x` from an example module drops
# the binary in the module root, which is easy to commit by accident.
/examples/*/arena
/examples/*/arenabot
/examples/*/arenad
/examples/*/arenatape
/examples/*/dispatch
/examples/*/field
/examples/*/fieldd
/examples/*/incident
/examples/*/incidentd
/examples/*/statusbot

# Documents an editd run leaves behind. Its default -data is ./documents
# relative to where it was started, which inside this checkout is the example
# module — runtime state, not part of the example.
/examples/editor/documents/
/examples/*/editd

# JavaScript package
/js/node_modules
